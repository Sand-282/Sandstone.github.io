# Use provider runtime settings. Never commit real passwords or API keys.
# Sites uses its trusted sign-in gateway. Direct Cloudflare Workers MUST use standalone.
AUTH_MODE=sites
# Hosted owner: cjgsinclare@gmail.com. Local Sites mock owner: seedy@sites.test.
ADMIN_EMAIL=
# Standalone only: provider secret with at least 16 UTF-8 bytes, ideally generated.
# There is no public registration or first-user claim.
ADMIN_PASSWORD=
# Exact public landing HTTPS origin, with no trailing slash.
PAGES_ORIGIN=https://sand-282.github.io
# Resend key and a sender address on a domain verified by Resend.
# Gmail can receive mail; EMAIL_FROM must be a verified sending identity.
RESEND_API_KEY=
EMAIL_FROM=
# Canonical backend HTTPS URL used for private portal and notification links.
# Standalone example shape: https://sandstone-commissions.ACCOUNT.workers.dev
SITE_URL=
# Local preview can use ignored .dev.vars; do not commit credentials.
# Keep email settings empty for tests. A loopback SITE_URL may use HTTP in local preview.
